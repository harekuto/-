+    private void toggleBookmark() {
+        BrowserTab tab = activeTab();
+        if (tab == null) return;
+        String url = UrlResolver.sanitizePersistent(tab.webView.getUrl());
+        if (url == null) {
+            toast("This page cannot be bookmarked");
+            return;
+        }
+        if (browserDataStore.isBookmarked(url)) {
+            browserDataStore.removeBookmark(url);
+            toast("Bookmark removed");
+        } else {
+            browserDataStore.addBookmark(tab.title, url);
+            toast("Bookmark saved");
+        }
+    }
+
+    private void showBookmarks() {
+        showEntryDialog("Bookmarks", browserDataStore.bookmarks());
+    }
+
+    private void showHistory() {
+        showEntryDialog("History", browserDataStore.history());
+    }
+
+    private void showEntryDialog(String title, List<BrowserDataStore.Entry> entries) {
+        if (entries.isEmpty()) {
+            toast(title + " is empty");
+            return;
+        }
+        int limit = Math.min(entries.size(), 100);
+        String[] labels = new String[limit];
+        for (int i = 0; i < limit; i++) {
+            BrowserDataStore.Entry entry = entries.get(i);
+            labels[i] = compact(entry.title, 54) + "\n" + compact(safeDisplayUrl(entry.url), 72);
+        }
+        AlertDialog dialog = new AlertDialog.Builder(this)
+                .setTitle(title)
+                .setItems(labels, (d, which) -> {
+                    if (which >= 0 && which < entries.size()) createTab(entries.get(which).url, true);
+                })
+                .setNegativeButton("Close", null)
+                .create();
+        dialog.setOnShowListener(d -> tintDialog(dialog));
+        dialog.show();
+    }
+
+    private void reopenClosedTab() {
+        BrowserDataStore.Entry entry = browserDataStore.popClosedTab();
+        if (entry == null) {
+            toast("No recently closed tabs");
+            return;
+        }
+        createTab(entry.url, true);
+    }
+
+    private void openCurrentInExternalBrowser() {
+        BrowserTab tab = activeTab();
+        String url = tab == null ? null : UrlResolver.sanitizePersistent(tab.webView.getUrl());
+        if (url == null) {
+            toast("This page cannot be opened externally");
+            return;
+        }
+        try {
+            startActivity(new Intent(Intent.ACTION_VIEW, Uri.parse(url)));
+        } catch (ActivityNotFoundException e) {
+            toast("No compatible browser found");
+        }
+    }
+
+    private void toggleDesktopSite() {
+        BrowserTab tab = activeTab();
+        if (tab == null) return;
+        tab.desktopSite = !tab.desktopSite;
+        WebSettings settings = tab.webView.getSettings();
+        if (tab.desktopSite) {
+            String major = currentWebViewMajorVersion();
+            if (major == null) {
+                tab.desktopSite = false;
+                toast("Desktop site is unavailable with this WebView");
+                return;
+            }
+            settings.setUserAgentString("Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/" + major + ".0.0.0 Safari/537.36");
+            settings.setUseWideViewPort(true);
+            settings.setLoadWithOverviewMode(true);
+            toast("Desktop site enabled");
+        } else {
+            settings.setUserAgentString(tab.defaultUserAgent);
+            settings.setUseWideViewPort(false);
+            settings.setLoadWithOverviewMode(false);
+            toast("Mobile site enabled");
+        }
+        tab.webView.reload();
+    }
+
+    private String currentWebViewMajorVersion() {
+        try {
+            if (Build.VERSION.SDK_INT >= 26 && WebView.getCurrentWebViewPackage() != null) {
+                String version = WebView.getCurrentWebViewPackage().versionName;
+                int dot = version.indexOf('.');
+                String major = dot > 0 ? version.substring(0, dot) : version;
+                if (major.matches("\\d{2,3}")) return major;
+            }
+        } catch (Exception ignored) {
+        }
+        BrowserTab tab = activeTab();
+        String ua = tab == null ? "" : tab.defaultUserAgent;
+        int marker = ua.indexOf("Chrome/");
+        if (marker >= 0) {
+            int start = marker + 7;
+            int end = ua.indexOf('.', start);
+            if (end > start) {
+                String major = ua.substring(start, end);
+                if (major.matches("\\d{2,3}")) return major;
+            }
+        }
+        return null;
+    }
