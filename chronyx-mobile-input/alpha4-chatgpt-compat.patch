+    private void openChatGptInCurrentTab() {
+        BrowserTab tab = activeTab();
+        if (tab == null) tab = createTab(CHATGPT_URL, true);
+        if (tab == null) return;
+        tab.chatGptCompatibility = sessionStore.chatGptCompatibilityEnabled();
+        applyChatGptCompatibility(tab);
+        tab.webView.loadUrl(CHATGPT_URL);
+    }
+
+    private void openChatGptInDefaultBrowser() {
+        try {
+            startActivity(new Intent(Intent.ACTION_VIEW, Uri.parse(CHATGPT_URL)));
+        } catch (ActivityNotFoundException e) {
+            toast("No compatible browser found");
+        }
+    }
+
+    private void applyChatGptCompatibility(BrowserTab tab) {
+        if (tab == null) return;
+        boolean enabled = sessionStore.chatGptCompatibilityEnabled() && tab.chatGptCompatibility;
+        WebSettings settings = tab.webView.getSettings();
+        settings.setMediaPlaybackRequiresUserGesture(!enabled);
+        settings.setDomStorageEnabled(true);
+        settings.setDatabaseEnabled(true);
+        settings.setJavaScriptEnabled(true);
+        settings.setSupportMultipleWindows(true);
+        CookieManager cookies = CookieManager.getInstance();
+        cookies.setAcceptCookie(true);
+        cookies.setAcceptThirdPartyCookies(tab.webView, enabled || sessionStore.thirdPartyCookiesEnabled());
+    }
+
+    private boolean isChatGptOrOpenAiUrl(String raw) {
+        if (raw == null || raw.trim().isEmpty()) return false;
+        try {
+            Uri uri = Uri.parse(raw);
+            String host = uri.getHost();
+            if (host == null) return false;
+            host = host.toLowerCase(Locale.ROOT);
+            return host.equals("chatgpt.com") || host.endsWith(".chatgpt.com") ||
+                    host.equals("openai.com") || host.endsWith(".openai.com");
+        } catch (Exception ignored) {
+            return false;
+        }
+    }
